pragma solidity ^0.8.28;
import "forge-std/Test.sol";
import "../../contracts/verifier/ProofRegistry.sol";
import "../../contracts/verifier/RoundVerifierEntry.sol";
import "../../contracts/RollaSettlementOptimistic.sol";

/// End-to-end: a proof too large for one tx is uploaded to the ProofRegistry in
/// ≤24KB chunks, then a tiny disproveWithRegistry tx reads it and runs the full
/// on-chain verify via an internal call — sidestepping the EVM per-tx calldata
/// limit. Uses the REAL round proof + REAL verifier (no mocks).
contract RegistryDisputeTest is Test {
    bytes constant PROOF = hex"";
    uint64 constant SEED = 305419896;
    uint64 constant OFH = 11147768201259037994;
    uint64 constant INIT = 429496729600;
    uint64 constant FINAL = 565441731328;

    ProofRegistry reg;
    RoundVerifierEntry entry;
    RollaSettlementOptimistic s;

    function setUp() public {
        reg = new ProofRegistry();
        entry = new RoundVerifierEntry();
        s = new RollaSettlementOptimistic(address(entry), address(0), 1800, 0.1 ether);
        s.setRegistry(address(reg));
        s.postCommit(7, keccak256(abi.encodePacked(SEED)));
        s.recordOrderFlow(7, OFH);
    }

    function _slice(bytes memory d, uint256 off, uint256 len) internal pure returns (bytes memory o) {
        o = new bytes(len);
        for (uint256 i = 0; i < len; i++) o[i] = d[off + i];
    }

    // upload the proof in 24KB chunks (each a small tx in production)
    function _upload(uint256 proofId) internal {
        uint256 CS = 24_000;
        for (uint256 off = 0; off < PROOF.length; off += CS) {
            uint256 len = off + CS > PROOF.length ? PROOF.length - off : CS;
            reg.appendChunk(proofId, _slice(PROOF, off, len));
        }
    }

    function test_registryRoundTripMatchesProof() public {
        _upload(1);
        assertEq(reg.read(address(this), 1), PROOF, "assembled proof != original");
    }

    function test_disproveWithRegistry_slashes() public {
        // house posts a WRONG final + bond
        address house = address(0xA11CE);
        vm.deal(house, 10 ether);
        vm.prank(house);
        s.postRound{value: 1 ether}(7, SEED, OFH, INIT, FINAL + 1);

        // watcher uploads the real proof in chunks, then disproves with a tiny tx
        address watcher = address(this);
        _upload(42);
        uint256 wb = watcher.balance;
        s.disproveWithRegistry(7, 42); // reads proof from registry, verifies internally
        assertEq(watcher.balance, wb + 1 ether, "slashed bond paid to disprover");

        (,,,,,,, bool finalized, bool voided) = s.postings(7);
        assertTrue(voided && !finalized, "round voided via registry disprove");
    }

    receive() external payable {}
}
